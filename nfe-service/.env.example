# Microserviço NF-e — variáveis de ambiente (definir no host, nunca versionar).

# Token Bearer que o Vital.IA usa para chamar este serviço.
# Deve ser IGUAL ao NFE_SERVICE_TOKEN configurado na Vercel.
NFE_SERVICE_TOKEN=

# Certificado A1 (e-CNPJ). Gere o base64 do .pfx com:
#   base64 -i certificado.pfx | tr -d '\n'
NFE_CERT_PFX_BASE64=
NFE_CERT_PASSWORD=

# Emitente (Vital Norte) — a NF-e exige endereço completo + IE + município IBGE,
# que o payload do app não traz; por isso ficam aqui (dados fixos do emitente).
NFE_CNPJ=
NFE_RAZAO_SOCIAL=
NFE_UF=AM
NFE_EMIT_IE=
NFE_EMIT_CRT=1
NFE_EMIT_LOGRADOURO=
NFE_EMIT_NUMERO=
NFE_EMIT_BAIRRO=
NFE_EMIT_CMUN=1302603
NFE_EMIT_XMUN=Manaus
NFE_EMIT_CEP=
NFE_EMIT_FONE=

# "homologacao" (padrão, sem valor fiscal) ou "producao"
NFE_AMBIENTE=homologacao
