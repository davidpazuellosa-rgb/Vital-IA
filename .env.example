NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GROQ_API_KEY=
# Opcionais: permitem trocar os modelos sem alterar o código.
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Alertas (execução automática + Telegram)
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
CRON_SECRET=

# Nota Fiscal (provedor Focus NFe)
# Homologação (sandbox): https://homologacao.focusnfe.com.br
# Produção:              https://api.focusnfe.com.br
FOCUS_NFE_BASE_URL=https://homologacao.focusnfe.com.br
FOCUS_NFE_TOKEN=
# Segredo do webhook de status. Configure a URL no Focus como:
#   https://SEU_DOMINIO/api/nota-fiscal/webhook?secret=ESTE_VALOR
FOCUS_NFE_WEBHOOK_SECRET=

# Motor de emissão de NF-e: "focus" (provedor, padrão) ou "sefaz" (integração direta).
NFE_ENGINE=focus
# Integração direta com a SEFAZ (NFE_ENGINE=sefaz) — microserviço em nfe-service/.
# URL do microserviço (deploy fora da Vercel) e token Bearer compartilhado.
NFE_SERVICE_URL=
NFE_SERVICE_TOKEN=
# Ambiente da SEFAZ: "homologacao" (padrão, sem valor fiscal) ou "producao".
NFE_SEFAZ_AMBIENTE=homologacao
